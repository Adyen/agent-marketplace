# Public default Go base image. Override with --build-arg BASE_IMAGE=... if
# your environment cannot pull Docker Hub directly.
ARG BASE_IMAGE=golang:1.26-alpine
FROM ${BASE_IMAGE}

# Install the E2E tools if the base image doesn't already provide them.
# `script` gives interactive confirmation tests a real terminal. Supports
# Alpine (apk) and Debian/Ubuntu (apt-get) based images.
RUN if command -v git >/dev/null 2>&1 && command -v script >/dev/null 2>&1; then \
        true; \
    elif command -v apk >/dev/null 2>&1; then \
        apk add --no-cache git util-linux; \
    elif command -v apt-get >/dev/null 2>&1; then \
        apt-get update && \
        apt-get install -y --no-install-recommends bsdutils git && \
        rm -rf /var/lib/apt/lists/*; \
    else \
        echo "no supported package manager found; please install git and script" >&2; \
        exit 1; \
    fi

# Create a non-root user for the E2E runner. Alpine provides busybox adduser,
# Debian provides useradd.
RUN if id -u runner >/dev/null 2>&1; then \
        true; \
    elif command -v useradd >/dev/null 2>&1; then \
        useradd -m -u 1000 runner; \
    elif command -v adduser >/dev/null 2>&1; then \
        adduser -D -u 1000 runner; \
    else \
        echo "no useradd or adduser found" >&2; \
        exit 1; \
    fi && \
    mkdir -p /home/runner/.cache /home/runner/go && \
    chown -R runner:runner /home/runner

ENV HOME=/home/runner
ENV GOPATH=/home/runner/go
ENV GOCACHE=/home/runner/.cache/go-build
ENV PATH=${PATH}:/home/runner/go/bin
ENV CGO_ENABLED=0

USER runner

RUN git config --global user.name "E2E Test" && \
    git config --global user.email "e2e@test.local" && \
    git config --global init.defaultBranch main

WORKDIR /src
COPY --chown=runner:runner . .

# Pre-download Go modules so the test run can work with a read-only GOPATH root.
WORKDIR /src/e2e
RUN go mod download
WORKDIR /src
RUN go mod download

WORKDIR /src/e2e
CMD ["go", "test", "-v", "-count=1", "-timeout", "20m", "./..."]
