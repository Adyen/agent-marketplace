ARG GO_BUILD_IMAGE=golang:1.26.6-alpine3.23
ARG ALPINE_RUNTIME_IMAGE=alpine:3.22.1
ARG BUILD_CA_CERT_PATH=/etc/ssl/certs/ca-certificates.crt

FROM --platform=$BUILDPLATFORM ${GO_BUILD_IMAGE} AS build

ARG VERSION=dev
ARG TARGETOS=linux
ARG TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build \
    -trimpath -buildvcs=false -ldflags "-s -w -X main.version=${VERSION}" \
    -o /out/agent-marketplace ./cmd/agent-marketplace

FROM ${ALPINE_RUNTIME_IMAGE} AS api
ARG BUILD_CA_CERT_PATH
COPY --from=build ${BUILD_CA_CERT_PATH} /tmp/build-ca-certificates.crt
RUN mkdir -p /etc/ssl/certs && cp /tmp/build-ca-certificates.crt /etc/ssl/certs/ca-certificates.crt \
    && rm /tmp/build-ca-certificates.crt \
    && addgroup -S marketplace && adduser -S -u 1000 -G marketplace marketplace \
    && mkdir -p /var/lib/agent-marketplace /tmp \
    && chown -R marketplace:marketplace /var/lib/agent-marketplace /tmp
WORKDIR /app
COPY --from=build --chown=marketplace:marketplace /out/agent-marketplace /app/agent-marketplace
USER marketplace
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q -O - -T 5 http://127.0.0.1:9090/readyz >/dev/null || exit 1
ENTRYPOINT ["/app/agent-marketplace"]
CMD ["serve", "--config", "/app/marketplace.yaml", "--role", "api"]

FROM ${ALPINE_RUNTIME_IMAGE} AS worker
ARG BUILD_CA_CERT_PATH
COPY --from=build ${BUILD_CA_CERT_PATH} /tmp/build-ca-certificates.crt
RUN mkdir -p /etc/ssl/certs && cp /tmp/build-ca-certificates.crt /etc/ssl/certs/ca-certificates.crt \
    && rm /tmp/build-ca-certificates.crt \
    && addgroup -S marketplace && adduser -S -u 1000 -G marketplace marketplace \
    && apk add --no-cache git \
    && mkdir -p /var/lib/agent-marketplace /tmp \
    && chown -R marketplace:marketplace /var/lib/agent-marketplace /tmp
WORKDIR /app
COPY --from=build --chown=marketplace:marketplace /out/agent-marketplace /app/agent-marketplace
USER marketplace
ENTRYPOINT ["/app/agent-marketplace"]
CMD ["serve", "--config", "/app/marketplace.yaml", "--role", "worker"]
