# Copy to .env outside version control and replace every placeholder.
# config.yaml is authoritative for the S3 bucket, region, and endpoint; these
# values are intentionally not duplicated as Compose variables.
MARKETPLACE_VERSION=dev
MARKETPLACE_HTTP_PORT=8080
POSTGRES_DB=marketplace
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=replace-with-a-random-password
MARKETPLACE_POSTGRES_DSN=postgres://marketplace:replace-with-a-random-password@postgres:5432/marketplace?sslmode=disable
# The AWS SDK reads these credentials from the API/worker environment.
AWS_ACCESS_KEY_ID=replace-with-access-key
AWS_SECRET_ACCESS_KEY=replace-with-secret-key
AWS_SESSION_TOKEN=replace-with-session-token-or-leave-empty
