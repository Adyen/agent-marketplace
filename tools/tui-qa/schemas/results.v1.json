{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-marketplace://tui-qa/schemas/results.v1.json",
  "title": "agent-marketplace TUI QA deterministic results, schema version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "runClass",
    "certifying",
    "invalidReasons",
    "startedAt",
    "finishedAt",
    "durationMs",
    "revision",
    "binary",
    "classifier",
    "fixture",
    "tools",
    "environment",
    "limits",
    "artifactPolicy",
    "flows",
    "findings",
    "finalDecision",
    "finalStatus",
    "exitCode"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[A-Za-z0-9._-]+$" },
    "runClass": { "enum": ["local", "baseline", "pr", "nightly", "release"] },
    "certifying": { "type": "boolean" },
    "invalidReasons": { "type": "array", "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 1000 }, "uniqueItems": true },
    "startedAt": { "type": "string", "minLength": 1, "maxLength": 64 },
    "finishedAt": { "type": "string", "minLength": 1, "maxLength": 64 },
    "durationMs": { "type": "integer", "minimum": 0, "maximum": 86400000 },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "head", "worktreeDirty"],
      "properties": {
        "base": { "type": "string", "minLength": 1, "maxLength": 128 },
        "head": { "type": "string", "minLength": 1, "maxLength": 128 },
        "worktreeDirty": { "type": "boolean" }
      }
    },
    "binary": { "$ref": "#/$defs/binary" },
    "classifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "input", "selections"],
      "properties": {
        "version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "input": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requestedFlowIds"],
          "properties": {
            "requestedFlowIds": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/id" }, "uniqueItems": true }
          }
        },
        "selections": {
          "type": "array",
          "maxItems": 500,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["flowId", "reason"],
            "properties": {
              "flowId": { "$ref": "#/$defs/id" },
              "reason": { "type": "string", "minLength": 1, "maxLength": 1000 }
            }
          }
        }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "string", "minLength": 1, "maxLength": 100 },
        "source": { "const": "local-synthetic" }
      }
    },
    "tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodeVersion", "npmVersion", "driver"],
      "properties": {
        "nodeVersion": { "type": "string", "minLength": 1, "maxLength": 100 },
        "npmVersion": { "type": "string", "minLength": 1, "maxLength": 100 },
        "driver": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": { "const": "@microsoft/tui-test" },
            "version": { "const": "0.0.4" }
          }
        }
      }
    },
    "environment": {
      "type": "object",
      "maxProperties": 32,
      "propertyNames": {
        "enum": ["AM_TUI_QA_RUN_ID", "AM_TUI_QA_RUN_CLASS", "AM_TUI_QA_COLUMNS", "AM_TUI_QA_ROWS", "AM_TUI_QA_RETRIES", "AM_TUI_QA_TIMEOUT_MS", "GOOS", "GOARCH", "TERM"]
      },
      "additionalProperties": { "type": "string", "maxLength": 1000 }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semanticWaitMs", "longOperationWaitMs", "flowTimeoutMs", "maxRetries", "transcriptCapBytes", "uploadCapBytes"],
      "properties": {
        "semanticWaitMs": { "const": 5000 },
        "longOperationWaitMs": { "const": 30000 },
        "flowTimeoutMs": { "type": "integer", "minimum": 1, "maximum": 120000 },
        "maxRetries": { "type": "integer", "minimum": 0, "maximum": 1 },
        "transcriptCapBytes": { "const": 10485760 },
        "uploadCapBytes": { "const": 104857600 }
      }
    },
    "artifactPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["retentionDays", "rawAnsiLocalOnly", "exceptionalRawUpload", "secretScanRequired", "uploadBytes", "uploadCapBytes", "truncated"],
      "properties": {
        "retentionDays": { "enum": [0, 7, 30] },
        "rawAnsiLocalOnly": { "const": true },
        "exceptionalRawUpload": { "type": "boolean" },
        "secretScanRequired": { "const": true },
        "uploadBytes": { "type": "integer", "minimum": 0, "maximum": 104857600 },
        "uploadCapBytes": { "const": 104857600 },
        "truncated": { "type": "boolean" }
      }
    },
    "flows": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/flow" } },
    "findings": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/finding" } },
    "finalDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "exitCode", "precedence", "reasons"],
      "properties": {
        "status": { "$ref": "#/$defs/finalStatus" },
        "exitCode": { "type": "integer", "minimum": 0, "maximum": 3 },
        "precedence": { "const": ["INVALID", "FAIL", "BLOCKED", "PASS", "NOT_APPLICABLE"] },
        "reasons": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "string", "minLength": 1, "maxLength": 1000 } }
      }
    },
    "finalStatus": { "$ref": "#/$defs/finalStatus" },
    "exitCode": { "type": "integer", "minimum": 0, "maximum": 3 }
  },
  "allOf": [
    {
      "if": { "properties": { "certifying": { "const": true } }, "required": ["certifying"] },
      "then": {
        "properties": {
          "binary": { "type": "object", "properties": { "buildClass": { "const": "release-equivalent" }, "cgoEnabled": { "const": false } } },
          "revision": { "type": "object", "properties": { "worktreeDirty": { "const": false } } }
        }
      }
    }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" },
    "flowStatus": { "enum": ["PASS", "FAIL", "BLOCKED", "FLAKY", "SKIP", "NOT_APPLICABLE"] },
    "finalStatus": { "enum": ["INVALID", "FAIL", "BLOCKED", "PASS", "NOT_APPLICABLE"] },
    "checkStatus": { "enum": ["PASS", "FAIL", "BLOCKED", "NOT_APPLICABLE"] },
    "failureClass": {
      "enum": [
        "ASSERTION_FAILED",
        "HANG_TIMEOUT",
        "UNEXPECTED_EXIT",
        "CONTROL_INJECTION",
        "TERMINAL_RESTORATION",
        "RETURNED_ERROR",
        "PANIC",
        "SIGKILL",
        "BLANK_SCREEN",
        "LEAKED_DESCENDANT",
        "CLIPPED_CHROME",
        "MISSING_CONTENT",
        "HARNESS_ERROR"
      ]
    },
    "binary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "buildClass", "cgoEnabled", "goVersion", "goos", "goarch", "command", "tags", "ldflags"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "buildClass": { "enum": ["release-equivalent", "instrumented"] },
        "cgoEnabled": { "type": "boolean" },
        "goVersion": { "type": "string", "pattern": "^go[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$" },
        "goos": { "type": "string", "minLength": 1, "maxLength": 50 },
        "goarch": { "type": "string", "minLength": 1, "maxLength": 50 },
        "command": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "string", "maxLength": 1000 } },
        "tags": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 200 } },
        "ldflags": { "type": "array", "maxItems": 100, "items": { "type": "string", "maxLength": 1000 } }
      }
    },
    "productRestoration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonical", "echo", "alternateScreenExited", "cursorVisible", "mouseDisabled", "bracketedPasteDisabled", "complete"],
      "properties": {
        "canonical": { "$ref": "#/$defs/checkStatus" },
        "echo": { "$ref": "#/$defs/checkStatus" },
        "alternateScreenExited": { "$ref": "#/$defs/checkStatus" },
        "cursorVisible": { "$ref": "#/$defs/checkStatus" },
        "mouseDisabled": { "$ref": "#/$defs/checkStatus" },
        "bracketedPasteDisabled": { "$ref": "#/$defs/checkStatus" },
        "complete": { "type": "boolean" }
      }
    },
    "harnessRecovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["applied", "canonical", "echo", "noDescendants", "complete"],
      "properties": {
        "applied": { "type": "boolean" },
        "canonical": { "$ref": "#/$defs/checkStatus" },
        "echo": { "$ref": "#/$defs/checkStatus" },
        "noDescendants": { "$ref": "#/$defs/checkStatus" },
        "complete": { "type": "boolean" }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attemptId", "attempt", "sandboxId", "startedAt", "finishedAt", "status", "exitCode", "signal", "durationMs", "observedFailureClass", "productRestoration", "harnessRecovery"],
      "properties": {
        "attemptId": { "$ref": "#/$defs/id" },
        "attempt": { "type": "integer", "minimum": 1, "maximum": 2 },
        "sandboxId": { "$ref": "#/$defs/id" },
        "startedAt": { "type": "string", "minLength": 1, "maxLength": 64 },
        "finishedAt": { "type": "string", "minLength": 1, "maxLength": 64 },
        "status": { "$ref": "#/$defs/flowStatus" },
        "exitCode": { "type": ["integer", "null"] },
        "signal": { "type": ["string", "null"], "maxLength": 50 },
        "durationMs": { "type": "integer", "minimum": 0, "maximum": 180000 },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "observedFailureClass": { "anyOf": [{ "$ref": "#/$defs/failureClass" }, { "type": "null" }] },
        "productRestoration": { "$ref": "#/$defs/productRestoration" },
        "harnessRecovery": { "$ref": "#/$defs/harnessRecovery" }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "expected", "observed"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "status": { "enum": ["PASS", "FAIL", "BLOCKED"] },
        "expected": { "type": "string", "maxLength": 10000 },
        "observed": { "type": "string", "maxLength": 10000 }
      }
    },
    "sideEffects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rootClass", "beforeDigest", "afterDigest", "changedPaths", "truncated"],
      "properties": {
        "rootClass": { "type": "string", "minLength": 1, "maxLength": 100 },
        "beforeDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "afterDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "changedPaths": { "type": "array", "maxItems": 1000, "items": { "type": "string", "maxLength": 1000 }, "uniqueItems": true },
        "truncated": { "type": "boolean" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "kind", "sanitized", "sanitization", "localOnly", "truncated"],
      "properties": {
        "path": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 104857600 },
        "kind": { "enum": ["sanitized-frame", "trace-summary", "command-log", "driver-log", "side-effect", "process-cleanup", "raw-trace", "other"] },
        "sanitized": { "type": "boolean" },
        "sanitization": { "enum": ["transformed", "raw"] },
        "localOnly": { "type": "boolean" },
        "truncated": { "type": "boolean" }
      }
    },
    "flow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["flowId", "kind", "driver", "boundary", "required", "status", "selectionReason", "fixtureId", "expectedFailureClass", "terminal", "attempts", "assertions", "sideEffects", "evidence"],
      "properties": {
        "flowId": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["invariant", "detector", "product"] },
        "driver": { "enum": ["pty", "command"] },
        "boundary": { "enum": ["real-pty-process", "non-tty-process"] },
        "required": { "type": "boolean" },
        "status": { "$ref": "#/$defs/flowStatus" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "selectionReason": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "fixtureId": { "$ref": "#/$defs/id" },
        "expectedFailureClass": { "anyOf": [{ "$ref": "#/$defs/failureClass" }, { "type": "null" }] },
        "terminal": {
          "type": "object",
          "additionalProperties": false,
          "required": ["profileId", "columns", "rows"],
          "properties": {
            "profileId": { "$ref": "#/$defs/id" },
            "columns": { "type": "integer", "minimum": 1, "maximum": 1000 },
            "rows": { "type": "integer", "minimum": 1, "maximum": 1000 }
          }
        },
        "attempts": { "type": "array", "maxItems": 2, "items": { "$ref": "#/$defs/attempt" } },
        "assertions": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/assertion" } },
        "sideEffects": { "$ref": "#/$defs/sideEffects" },
        "evidence": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/evidence" } }
      },
      "allOf": [
        {
          "if": { "properties": { "driver": { "const": "pty" } }, "required": ["driver"] },
          "then": { "properties": { "boundary": { "const": "real-pty-process" } } }
        }
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["severity", "classification", "title"],
      "properties": {
        "severity": { "enum": ["critical", "high", "medium", "low"] },
        "classification": { "enum": ["product", "environment", "harness", "coverage"] },
        "title": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "flowId": { "$ref": "#/$defs/id" },
        "issue": { "type": "string", "minLength": 1, "maxLength": 1000 }
      }
    }
  }
}
