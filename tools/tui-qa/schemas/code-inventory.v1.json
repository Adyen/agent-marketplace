{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-marketplace://tui-qa/schemas/code-inventory.v1.json",
  "title": "agent-marketplace TUI code inventory, schema version 1",
  "description": "Deterministic QA-only projection of code-owned TUI screen, action, state, and target identities.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "screens", "actions", "states", "targets"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "screens": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/action" },
      "uniqueItems": true
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "$ref": "#/$defs/id" },
      "uniqueItems": true
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/target" },
      "uniqueItems": true
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "keys", "helpKey", "helpDescription"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "prefix": { "$ref": "#/$defs/id" },
        "keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": { "type": "string", "minLength": 1, "maxLength": 100 },
          "uniqueItems": true
        },
        "helpKey": { "type": "string", "minLength": 1, "maxLength": 100 },
        "helpDescription": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    }
  }
}
