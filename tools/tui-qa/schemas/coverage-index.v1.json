{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-marketplace://tui-qa/schemas/coverage-index.v1.json",
  "title": "agent-marketplace TUI QA coverage index, schema version 1",
  "description": "Stable input contract for change-aware flow selection. It cannot alter deterministic flow requirements.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "classifierVersion", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "classifierVersion": { "type": "string", "minLength": 1, "maxLength": 100 },
    "entries": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surface", "paths", "flowIds", "reason"],
        "properties": {
          "surface": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" },
          "paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\]+$" },
            "uniqueItems": true
          },
          "flowIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$" },
            "uniqueItems": true
          },
          "reason": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    }
  }
}
