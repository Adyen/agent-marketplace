{
  "name": "@adyen/agent-marketplace-tui-qa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Direct real-terminal usage tests for the agent-marketplace TUI.",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.18.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "pnpm typecheck && tui-test --help",
    "qa": "pnpm build && pnpm qa:compiled",
    "qa:compiled": "node --test dist/tests/*.test.js && tui-test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@microsoft/tui-test": "0.0.4",
    "@types/node": "26.4.0",
    "typescript": "5.9.3"
  }
}
