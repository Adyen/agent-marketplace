{
  "name": "agent-marketplace-gui",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "api:generate": "node scripts/generate-api.mjs",
    "api:drift": "node scripts/generate-api.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm run api:drift && pnpm run typecheck && vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "24.10.1",
    "openapi-typescript": "7.9.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
