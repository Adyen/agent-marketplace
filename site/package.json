{
  "name": "agent-marketplace-site",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.26.0",
  "description": "Landing page and documentation site for agent-marketplace",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vitepress dev",
    "build": "vitepress build",
    "preview": "vitepress preview",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.1.2",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "eslint": "10.8.0",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.8.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitepress": "1.6.4",
    "vue": "3.5.22",
    "vue-tsc": "3.0.0"
  }
}
