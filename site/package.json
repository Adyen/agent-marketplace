{
  "name": "agent-marketplace-site",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.26.0",
  "description": "Landing page and documentation site for agent-marketplace",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vitepress dev",
    "build": "vitepress build",
    "preview": "vitepress preview",
    "test": "node --test tests/*.test.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "docs:snapshot": "node scripts/docs.mjs snapshot",
    "docs:check": "node scripts/docs.mjs check"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "@types/node": "24.3.0",
    "typescript": "5.9.3",
    "vitepress": "1.6.4",
    "vue": "3.5.41",
    "vue-tsc": "3.0.0"
  }
}
