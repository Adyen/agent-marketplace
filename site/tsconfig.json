{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "allowJs": true,
    "skipLibCheck": true,
    "types": ["vitepress/client", "node"]
  },
  "include": [".vitepress/**/*.ts", ".vitepress/**/*.mts", "src/**/*.ts", "src/**/*.vue", "tests/**/*.ts"]
}
