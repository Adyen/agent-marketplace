        "~/.config/devin"
      ],
      "capabilities": {
        "compile": true,
        "ingest": true,
        "convert": true,
        "tui": true
      }
    },
    {
      "id": "codex",
      "label": "Codex",
      "repoRoots": [
        ".agents",
        ".codex"
      ],
      "machineRoots": [
        "~/.agents",
